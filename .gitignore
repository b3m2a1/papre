# Local review state, manuscript snapshots, demo repositories, previews, and QA.
/.runtime/
/review_queue/

# Python bytecode and development caches.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local environments and packaging output.
/.venv/
/venv/
/env/
/build/
/dist/
*.egg-info/
.eggs/

# Local secrets; example configuration can be committed.
.env
.env.*
!.env.example
!.env.sample

# Editor and operating-system files.
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Generated TeX auxiliaries. Keep source, patch fixtures, and intentional PDFs.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
*.nav
*.snm
*.vrb
*.xdv
